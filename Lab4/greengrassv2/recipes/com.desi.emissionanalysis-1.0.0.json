{
    "RecipeFormatVersion": "2020-01-25",
    "ComponentName": "com.desi.emissionanalysis",
    "ComponentVersion": "1.0.0",
    "ComponentDescription": "subscribes to local MQTT topics for emission data, processes CO2 readings to calculate max emission levels, and pubs results back to greengrass core.",
    "ComponentPublisher": "Serial Team Desi CS437",
    "ComponentConfiguration": {
        "DefaultConfiguration": {
            "ipc-subscribe-topics": ["clients/+/emission/data"],
            "mqtt-subscribe-topics": [],
            "input_topic": "clients/+/emission/data",
            "output_topic": "clients/+/emission/result",
            "vehicle_id": "CS437Car1",
            "max_threshold": 5000,
            "publish_interval_sec": 5
        }
    },
  "Manifests": [
    {
      "Platform": {
        "os": "linux"
      },
      "Lifecycle": {
        "Run": "python3 -u {artifacts:path}/main.py"
      }
    },
    {
      "Platform": {
        "os": "windows"
      },
      "Lifecycle": {
        "Run": "py -3 -u {artifacts:path}/main.py"
      }
    }
  ]
}