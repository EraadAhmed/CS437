{
    "RecipeFormatVersion": "2020-01-25",
    "ComponentName": "com.desi.emissionanalysis",
    "ComponentVersion": "1.0.1",
    "ComponentDescription": "subscribes to local MQTT topics for emission data",
    "ComponentPublisher": "Serial Team Desi CS437",
    "ComponentConfiguration": {
        "DefaultConfiguration": {
            "input_topic": "clients/+/emission/data",
            "output_topic": "clients/+/emission/result",
            "vehicle_id": "CS437Car1"
        }
    },
    "Manifests": [
        {
            "Platform": {
                "os": "linux"
            },
            "Lifecycle": {
                "Install": "pip3 install awsiotsdk --break-system-packages",
                "Run": "python3 -u {artifacts:path}/main.py '{configuration:/}'"
            }
        }
    ]
}